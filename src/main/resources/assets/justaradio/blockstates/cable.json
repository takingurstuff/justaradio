{
  "multipart": [
    {
      "apply": {
        "model": "justaradio:block/cable"
      }
    },
    {
      "when": { "north": "true" },
      "apply": {
        "model": "justaradio:block/cable_arm",
        "x": 0,
        "y": 0
      }
    },
    {
      "when": { "east": "true" },
      "apply": {
        "model": "justaradio:block/cable_arm",
        "x": 0,
        "y": 90
      }
    },
    {
      "when": { "south": "true" },
      "apply": {
        "model": "justaradio:block/cable_arm",
        "x": 0,
        "y": 180
      }
    },
    {
      "when": { "west": "true" },
      "apply": {
        "model": "justaradio:block/cable_arm",
        "x": 0,
        "y": 270
      }
    },
    {
      "when": { "up": "true" },
      "apply": {
        "model": "justaradio:block/cable_arm",
        "x": 270,
        "y": 0
      }
    },
    {
      "when": { "down": "true" },
      "apply": {
        "model": "justaradio:block/cable_arm",
        "x": 90,
        "y": 0
      }
    }
  ]
}
